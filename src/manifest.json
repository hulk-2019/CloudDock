{
  "manifest_version": 3,
  "name": "CloudDock",
  "version": "1.0.0",
  "description": "云端存储，随手可得 - 支持多云厂商的浏览器云存储管理插件",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://*.aliyuncs.com/*",
    "https://*.myqcloud.com/*",
    "https://*.qiniucdn.com/*",
    "https://*.qiniup.com/*",
    "https://*.amazonaws.com/*",
    "https://*.s3.amazonaws.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.tsx"]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "src/help/index.html",
  "commands": {
    "toggle-drawer": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "打开/关闭云盘抽屉"
    },
    "screenshot-upload": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "截图并上传"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "docs/*", "src/preview/index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
